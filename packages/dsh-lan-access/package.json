{
  "name": "dsh-lan-access",
  "version": "0.2.0",
  "description": "dsh web 局域网访问支持：crypto.randomUUID polyfill + 访问令牌验证（回环豁免）+ 特权围栏/设置持久化放行。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}
