{
  "name": "dsh-vision",
  "version": "0.1.0",
  "description": "视觉读图工具：通过 OpenCode Zen Go 调用视觉模型（默认 mimo-v2.5）描述本地图片（dsh 插件：dsh-vision）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}